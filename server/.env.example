# API key for simple authentication. If empty or unset, auth is disabled.
API_KEY=

# Encryption seed for data source configs stored in SQLite.
# Strongly recommended to set in production and keep stable across restarts.
# CONFIG_ENCRYPTION_KEY=change-this-to-a-long-random-secret
# Auto key rotation policy (data source config encryption key):
# CONFIG_AUTO_ROTATE_ENABLED=true
# CONFIG_AUTO_ROTATE_DAYS=30

# Network binding
HOST=0.0.0.0
PORT=8000
APP_VERSION=0.1.0
# GitHub release updater (owner/repo), e.g. your-org/nfatool
# GITHUB_REPO=
# UPDATE_ASSET_LINUX=nfa95
# UPDATE_ASSET_WINDOWS=nfa95.exe

# Timezone for window calculations and scheduling
TIMEZONE=Asia/Shanghai

# Retention of job runs and artifacts in days
RETENTION_DAYS=30

# Concurrency limit for job executions
CONCURRENCY_LIMIT=3

# Optional custom directories. Relative paths resolve next to the executable (or server/ in dev)
# STORAGE_DIR=storage
# LOG_DIR=logs

# MySQL connection for 95th percentile compute (recommended for production)
# If not set, the app will fallback to reading db_config.ini next to the executable
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
# MYSQL_CHARSET=utf8mb4

# Multi-instance database catalogs (JSON object).
# Task can pick `data_source_type` + `data_source_instance`.
# NFA example:
# NFA_INSTANCES_JSON={"prod":{"host":"127.0.0.1","port":3306,"user":"nfa","password":"***","db":"nfa_db","charset":"utf8mb4"}}
# EDC example (supports table/column overrides):
# EDC_INSTANCES_JSON={"ali":{"host":"127.0.0.1","port":3306,"user":"edc","password":"***","db":"cloud","charset":"utf8mb4","table":"edc_data","time_column":"create_time","name_column":"edc_name","value_column":"service_size","exclude_like":"%-backup","wildcard_mode":"prefix","daily_rank_index":14}}
#
# EDC over SSH example (when MySQL only reachable from jump host):
# EDC_INSTANCES_JSON={"local-ssh":{"host":"127.0.0.1","port":3306,"user":"edc","password":"***","db":"cloud","charset":"utf8mb4","table":"edc_data","time_column":"create_time","name_column":"edc_name","value_column":"service_size","exclude_like":"%-backup","wildcard_mode":"prefix","daily_rank_index":14,"ssh_enabled":true,"ssh_host":"1.2.3.4","ssh_port":22,"ssh_user":"ops","ssh_password":"***","ssh_remote_host":"127.0.0.1","ssh_remote_port":3306}}
# Optional SSH key auth fields:
# "ssh_pkey":"C:/path/id_rsa","ssh_pkey_password":"***"
# Optional no-password auth via ssh-agent/default keys:
# "ssh_allow_agent":true
# Optional compatibility for very old SSH servers (e.g. OpenSSH_6.x):
# "ssh_legacy_rsa":true
# Optional transient network retry controls:
# "ssh_connect_retries":3,
# "ssh_retry_delay_ms":800

# Optional: MySQL connection for compute95 (if not using db_config.ini)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=
# MYSQL_CHARSET=utf8mb4
